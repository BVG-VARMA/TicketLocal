# TicketLocal Environment Configuration
PROJECT_NAME="TicketLocal"
VERSION="1.0.0"
ENVIRONMENT="development"
ENABLE_CHAOS=true

# Database (PostgreSQL)
# For local Docker: postgresql+asyncpg://ticketlocal:ticketlocal_secret@localhost:5432/ticketlocal_db
# For lightweight standalone/offline mode: sqlite+aiosqlite:///./ticketlocal.db
DATABASE_URL="postgresql+asyncpg://ticketlocal:ticketlocal_secret@localhost:5432/ticketlocal_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache & Seat Locking Engine
# For local Docker/native Redis: redis://localhost:6379/0
# Automatic fallback to in-memory fake_aioredis if connection fails
REDIS_URL="redis://localhost:6379/0"
REDIS_LOCK_TTL_SECONDS=600

# Authentication (JWT)
SECRET_KEY="ticketlocal-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Pricing & Tax Configuration
CONVENIENCE_FEE_PERCENTAGE=0.10
GST_TAX_PERCENTAGE=0.18
PRIME_TIME_START_HOUR=18
PRIME_TIME_END_HOUR=22
WEEKEND_SURGE_MULTIPLIER=1.25
PRIME_TIME_SURGE_MULTIPLIER=1.15

# Storage
STORAGE_DIR="./storage"
TICKETS_DIR="./storage/tickets"
